{
  "name": "character-archive",
  "version": "0.1.26",
  "description": "Card-view character archive. Local notes, easy share.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "test": "node --test tests/*.test.ts",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "pack": "node scripts/pack.mjs",
    "deploy": "node scripts/deploy.mjs",
    "deploy:reload": "node scripts/deploy.mjs --reload",
    "deploy:copy": "node scripts/deploy.mjs --no-build"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "character",
    "gallery"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.15.17",
    "esbuild": "0.25.5",
    "obsidian": "latest",
    "typescript": "^5.8.3"
  }
}
